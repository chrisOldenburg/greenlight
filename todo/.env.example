# Schluessel fuer alle /api-Routen. Ohne ihn antwortet die API mit 401.
# Erzeugen zum Beispiel mit: openssl rand -hex 24
API_KEY=bitte-aendern

# Token vom BotFather. Leer lassen, wenn TELEGRAM_ENABLED=false.
TELEGRAM_TOKEN=

# Eigene Chat-ID. 0 oder leer = Einrichtungsmodus: eingehende Chat-IDs
# werden nur ins Log geschrieben, es wird nichts verarbeitet.
TELEGRAM_CHAT_ID=0

# Poller abschaltbar, das Backend laeuft trotzdem.
TELEGRAM_ENABLED=true

# Pfad der SQLite-Datei. Im Container liegt /data im Volume.
DB_PATH=/data/tasks.db

# Maximale Anzahl Eintraege im Display-Payload.
DISPLAY_LIMIT=12

# Erledigte Aufgaben aelter als das werden beim Start und taeglich geloescht.
KEEP_DONE_DAYS=30
